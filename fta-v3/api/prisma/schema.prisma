generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model DemoCoach {
  id String @id
  name String
  specialty String
  members DemoMember[]
}
model DemoMember {
  id String @id
  name String
  status String
  coachId String
  coach DemoCoach @relation(fields: [coachId], references: [id])
  plans DemoPlan[]
  appointments DemoAppointment[]
}
model DemoPlan {
  id String @id
  title String
  status String
  memberId String
  member DemoMember @relation(fields: [memberId], references: [id])
}
model DemoAppointment {
  id String @id
  title String
  startsAt DateTime
  status String
  memberId String
  member DemoMember @relation(fields: [memberId], references: [id])
}
model DemoProduct {
  id String @id
  title String
  kind String
  priceToman Int
}

enum TrainingRole {
 ADMIN
 ATHLETE
}
enum TrainingStatus {
 DRAFT
 PUBLISHED
 ARCHIVED
}
model TrainingAccount {
 id String @id @default(uuid())
 email String @unique
 name String
 phone String? @unique
 passwordHash String
 role TrainingRole
 active Boolean @default(true)
 mustChangePassword Boolean @default(true)
 stagingBookingEnabled Boolean @default(false)
 createdAt DateTime @default(now())
 sessions TrainingSession[]
 assigned TrainingAssignment[] @relation("AthleteAssignment")
 coached TrainingAssignment[] @relation("CoachAssignment")
 entries TrainingEntry[]
 consultationSlots ConsultationSlot[]
 consultationBookings ConsultationBooking[]
 receivedMessages TrainingMessage[] @relation("MessageAthlete")
 sentMessages TrainingMessage[] @relation("MessageSender")
}
model TrainingSession {
 tokenHash String @id
 accountId String
 account TrainingAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([accountId])
 @@index([expiresAt])
}
model TrainingLoginBucket {
 key String @id
 count Int @default(1)
 expiresAt DateTime
 @@index([expiresAt])
}
model TrainingAssignment {
 id String @id @default(uuid())
 athleteId String
 athlete TrainingAccount @relation("AthleteAssignment",fields:[athleteId],references:[id],onDelete:Restrict)
 coachId String
 coach TrainingAccount @relation("CoachAssignment",fields:[coachId],references:[id],onDelete:Restrict)
 title String
 description String?
 sessions Json
 startsOn DateTime? @db.Date
 endsOn DateTime? @db.Date
 status TrainingStatus @default(DRAFT)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 entries TrainingEntry[]
 @@index([athleteId,status])
}
model TrainingEntry {
 id String @id @default(uuid())
 assignmentId String
 assignment TrainingAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
 athleteId String
 athlete TrainingAccount @relation(fields:[athleteId],references:[id],onDelete:Restrict)
 performedOn DateTime @db.Date
 sessionDay String
 effort Int?
 notes String?
 updatedAt DateTime @updatedAt
 @@unique([assignmentId,athleteId,performedOn,sessionDay])
 @@index([athleteId,performedOn])
}

enum ConsultationStatus {
 REQUESTED
 CONFIRMED
 COMPLETED
 CANCELLED
}
model ConsultationSlot {
 id String @id @default(uuid())
 startsAt DateTime @unique @db.Timestamptz(3)
 endsAt DateTime @db.Timestamptz(3)
 active Boolean @default(true)
 createdById String
 createdBy TrainingAccount @relation(fields:[createdById],references:[id],onDelete:Restrict)
 bookings ConsultationBooking[]
}
model ConsultationBooking {
 id String @id @default(uuid())
 slotId String
 slot ConsultationSlot @relation(fields:[slotId],references:[id],onDelete:Restrict)
 activeSlotId String? @unique
 athleteId String
 athlete TrainingAccount @relation(fields:[athleteId],references:[id],onDelete:Restrict)
 status ConsultationStatus @default(REQUESTED)
 athleteNote String?
 coachNote String?
 createdAt DateTime @default(now())
 cancelledAt DateTime?
 @@index([athleteId,createdAt])
}
model TrainingMessage {
 id String @id @default(uuid())
 athleteId String
 athlete TrainingAccount @relation("MessageAthlete",fields:[athleteId],references:[id],onDelete:Restrict)
 senderId String
 sender TrainingAccount @relation("MessageSender",fields:[senderId],references:[id],onDelete:Restrict)
 body String
 createdAt DateTime @default(now())
 readByAthleteAt DateTime?
 readByCoachAt DateTime?
 @@index([athleteId,createdAt])
}
model TrainingActionBucket {
 key String @id
 count Int @default(1)
 expiresAt DateTime
 @@index([expiresAt])
}
