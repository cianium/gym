# ============================================================================
# WHITE-LABEL FITNESS PLATFORM v2.3.0 — LARAVEL 13 ENVIRONMENT (.env.example)
# ============================================================================

APP_NAME="آکادمی رسمی مربی"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://your-coach-domain.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

INSTALLER_SETUP_TOKEN=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@your-coach-domain.ir
INITIAL_ADMIN_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_wlfitness
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

PAYMENT_SANDBOX=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL="${APP_URL}/api/v1/payments/callback/zarinpal"

SEP_TERMINAL_ID=
SEP_SANDBOX=false
SEP_CALLBACK_URL="${APP_URL}/api/v1/payments/callback/sep"

DOWNLOAD_TOKEN_TTL_HOURS=72
MAX_DIGITAL_DOWNLOAD_ATTEMPTS=5

LOG_CHANNEL=stack
LOG_LEVEL=error
MAIL_MAILER=smtp
MAIL_HOST=mail.your-coach-domain.ir
MAIL_PORT=465
MAIL_USERNAME=info@your-coach-domain.ir
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@your-coach-domain.ir"
MAIL_FROM_NAME="${APP_NAME}"

# Athlete registration OTP (provider shared-service template with args [OTP])
ATHLETE_MELIPAYAMAK_TOKEN=
ATHLETE_MELIPAYAMAK_BODY_ID=

# Appointment confirmation SMS; template args = [booking code, local YYYY/MM/DD, HH:mm]
BOOKING_MELIPAYAMAK_TOKEN=
BOOKING_MELIPAYAMAK_BODY_ID=
COACH_NOTIFICATION_PHONE=

# Verified athlete checkout and idempotency are mandatory in 2.3.2.
# The values below document the policy; server routes enforce it regardless of env overrides.
FITNESS_REQUIRE_VERIFIED_CHECKOUT=true

# Keep this key in a safe secret vault: losing it makes encrypted snapshots unreadable.
# The first-time installer generates it automatically. Set manually for upgrades.
BACKUP_ENCRYPTION_KEY=

# Every new checkout request must use a stable client-generated key.
FITNESS_REQUIRE_IDEMPOTENCY_KEY=true
