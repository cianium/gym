generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model DemoCoach {
  id String @id
  name String
  specialty String
  members DemoMember[]
}
model DemoMember {
  id String @id
  name String
  status String
  coachId String
  coach DemoCoach @relation(fields: [coachId], references: [id])
  plans DemoPlan[]
  appointments DemoAppointment[]
}
model DemoPlan {
  id String @id
  title String
  status String
  memberId String
  member DemoMember @relation(fields: [memberId], references: [id])
}
model DemoAppointment {
  id String @id
  title String
  startsAt DateTime
  status String
  memberId String
  member DemoMember @relation(fields: [memberId], references: [id])
}
model DemoProduct {
  id String @id
  title String
  kind String
  priceToman Int
}
